# Copy to .env for local development.
# On Beachhead, set these in the dashboard as GLOBAL env vars (no Target
# Service) so Compose can substitute them into docker-compose.yml.

# Password for the bundled Postgres. Any long random string.
DB_PASSWORD=change-me-to-something-long

# From your app's "Client credentials" page in the Shopify Partner dashboard.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# The public https origin Beachhead serves this app on. No trailing slash.
# Must exactly match the App URL configured in the Partner dashboard.
APP_URL=https://your-app.example.com

# Optional overrides.
SHOPIFY_API_VERSION=2026-07
SHOPIFY_SCOPES=read_products,write_products,read_inventory
SCHEDULER_ENABLED=true
